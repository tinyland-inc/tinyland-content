"""
BUILD.bazel for @tummycrypt/tinyland-content.

  Bazel:      bazel build //:pkg && bazel test //...
  Consumers:  bazel_dep(name = "tummycrypt_tinyland_content", version = "1.1.0")
              from xoxd-ai/bazel-registry; the package is not published to npm.
"""

load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_tinyland_content_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_content_npm//:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

# First-party deps resolved via the Bazel module graph (TIN-1716).
npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-content-types",
    src = "@tummycrypt_tinyland_content_types//:pkg",
)


ts_project(
    name = "tinyland_content",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    declaration_map = True,
    source_map = False,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    out_dir = "dist",
    root_dir = "src",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/gray-matter",
        ":node_modules/nanoid",
        ":node_modules/diff",
        ":node_modules/@types/diff",
        ":node_modules/@types/node",
        ":node_modules/@tummycrypt/tinyland-content-types",
    ],
    visibility = ["//visibility:public"],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":tinyland_content",
    ],
    package = "@tummycrypt/tinyland-content",
    version = "1.1.0",
    visibility = ["//visibility:public"],
)

vitest_bin.vitest_test(
    name = "test",
    data = [
        ":node_modules",
        "package.json",
        "MODULE.bazel",
        "BUILD.bazel",
        "tsconfig.json",
        ":node_modules/vitest",
        "vitest.config.ts",
        ".github/lanes.json",
        "docs/gf-v4-qualification.candidate.yml",
        "scripts/check-package-artifact.mjs",
        ":node_modules/@tummycrypt/tinyland-content-types",
    ] + glob(["src/**/*.ts"]) + glob(["tests/**/*.test.ts", "tests/**/*.ts"]) + glob([
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
    ], allow_empty = True),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "typecheck",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    declaration = False,
    no_emit = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig.json",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/gray-matter",
        ":node_modules/nanoid",
        ":node_modules/diff",
        ":node_modules/@types/diff",
        ":node_modules/@types/node",
        ":node_modules/@tummycrypt/tinyland-content-types",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)

# Inspect the complete Bazel-produced package, not a second npm/pnpm pack.
js_test(
    name = "package_artifact_test",
    entry_point = "scripts/check-package-artifact.mjs",
    args = ["$(rootpath :pkg)"],
    data = [
        ":pkg",
        ":node_modules/publint",
        "package.json",
        "scripts/check-package-artifact.mjs",
    ],
    visibility = ["//visibility:public"],
)
